<?xml version="1.0" encoding="utf-8"?>
<!--
  Reglas de backup para Android < 12 (fullBackupContent).
  RKStorage/SecureStore ya cifra con una clave ligada al Keystore del dispositivo
  (no exportable), así que un backup restaurado en otro dispositivo no podría
  descifrarlo igual; aun así lo excluimos explícitamente por defensa en profundidad.
-->
<full-backup-content>
    <exclude domain="database" path="RKStorage"/>
    <exclude domain="database" path="AsyncStorage"/>
    <exclude domain="sharedpref" path="SecureStore.xml"/>
</full-backup-content>
