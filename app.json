{
  "expo": {
    "name": "QueVesVe!&",
    "slug": "quevesve",
    "scheme": "quevesve",
    "privacy": "public",
    "platforms": ["ios", "android", "web"],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/leaf.png",
    "splash": {
      "image": "./src/assets/leaf.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5A623"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "googleWebClientId": "",
      "googleAndroidClientId": "",
      "googleIosClientId": "",
      "facebookAppId": ""
    }
  }
}
