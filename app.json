{
  "expo": {
    "name": "QueVesVe!&",
    "slug": "quevesve",
    "owner": "ccognitions",
    "scheme": "quevesve",
    "privacy": "public",
    "platforms": ["ios", "android", "web"],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/leaf.png",
    "splash": {
      "image": "./src/assets/leaf.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5A623"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.quevesve.app",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/leaf.png",
        "backgroundColor": "#F5A623"
      },
      "permissions": []
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      "./plugins/withLargeHeap.js"
    ],
    "extra": {
      "eas": {
        "projectId": "a778f3e8-5507-4025-a4bc-5f36f5031008"
      }
    }
  }
}
